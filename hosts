[server]
# NOTE: raspberrypi has no host_vars file → inherits all role defaults →
# base_dotfiles_enabled: false, no secrets deployed. To activate dotfiles,
# create host_vars/raspberrypi with base_dotfiles_enabled: true.
raspberrypi
serverannah

[workstation]
# Test VM first. With GNOME Boxes NAT, forward host port 2222 to guest port 22
# and set ansible_port accordingly in host_vars/savannarchome.
savannarchome
# Raspberry Pi 4 (Debian trixie, aarch64) used as a CLI/TUI dev + AI test bench.
raspi

[kids]
# Linux Mint 22.3 (XFCE) on an old MacBook, reached as daddy@192.168.1.41.
# Strict timekpr parental controls + learning/gaming apps via the kids role.
kidsbook

[mothers_windows]
# Managed only by windows_health.yml. This host must not be included in local.yml:
# that playbook intentionally contains Linux-only package and systemd roles.
isabe-pc ansible_host=100.80.190.1 ansible_user=isabe ansible_connection=ssh ansible_shell_type=powershell ansible_ssh_private_key_file=/home/lion/.ssh/isabe-windows ansible_ssh_common_args='-o IdentitiesOnly=yes'
