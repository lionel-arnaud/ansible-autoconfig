    hostname: 192.168.1.100
    user: lion
    known_host: "serverannah,192.168.1.100 ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMX9G6OI23dVKAGOGQzdnhYCtUfqfI1w28spHCW2IPcs"
  - name: raspi
    hostname: 192.168.1.99
    user: lion
    known_host: "raspi,192.168.1.99 ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAFcjgjopTvRIQydKF0LbaAGHqpvDAO38CJjNNf5E4+W"
  - name: kidsbook
    hostname: 192.168.1.41
    user: daddy
