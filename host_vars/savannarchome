---
# Production Omarchy/Arch workstation. Runs the playbook locally (no SSH hop).
ansible_connection: local
ansible_user: lion
ansible_python_interpreter: /usr/bin/python3

desktop_user: lion
base_dotfiles_enabled: true
base_lazydocker_enabled: true
workstation_enabled: true
workstation_cli_enabled: true
workstation_dotfiles_enabled: true
workstation_espanso_enabled: true
workstation_keyd_enabled: true
# Failure notifications. Generates its own topic, separate from the server's, so
# one leaked topic does not expose both machines.
notify_enabled: true

# Chromium new tab opens the homelab dashboard.
#
# Deliberately the LAN URL and not https://homepage.dinnizer.com: the public
# route sits behind Caddy basic auth, which would raise a browser-native
# password dialog on every single new tab — and desktop Bitwarden cannot
# autofill those, only the mobile app can. The .lan name comes from the Pi-hole
# search domain, so it needs no auth and survives the LAN IP changing.
#
# Off the home network the new tab will fail to load; that is the trade for not
# being prompted for a password every time a tab opens.
workstation_chromium_managed_policies:
  NewTabPageLocation: http://serverannah.lan:3000
omarchy_allow_ansible_package_installs: true

dotfiles_stow_packages:
  - bash
  - starship
  - claude
  - ssh
  - opencode
  - nvim
  - git
  - gh
  - lazygit
  - hypr
  - omarchy
  - wireplumber
  - systemd
  - scripts
  - espanso

# Secret dotfiles deployed by copy-decrypt (not Stow). The vaulted source holds
# the real SSH host aliases; the public ssh package only ships the sanitized
# config that Includes this file. Needs a vault password at run time.
dotfiles_secret_files:
  - src: "{{ dotfiles_secret_source_dir }}/ssh/config.local"
    dest: .ssh/config.local
    mode: "0600"
    dir_mode: "0700"

# Systemd user services to enable after stow deploys them. rclone-gdrive-mount
# is deliberately NOT listed here: the workstation role templates that unit with
# this host's mount point and manages its lifecycle itself (see below), so
# listing it would enable it before the template had been written.
workstation_systemd_user_services:
  - audio-policy.service
  - freebox-mount.service

# Google Drive mounted at ~/Google Drive Perso. The remote is already authorised
# for lion on this machine.
workstation_rclone_gdrive_enabled: true
