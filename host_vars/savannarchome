# Failure notifications. Generates its own topic, separate from the server's, so
# one leaked topic does not expose both machines.
notify_enabled: true
disk_monitor_enabled: true
disk_monitor_mounts:
  - /

# Chromium new tab opens the homelab dashboard.
#
# Deliberately the LAN URL and not https://homepage.dinnizer.com: the public
# route sits behind Caddy basic auth, which would raise a browser-native
# password dialog on every single new tab — and desktop Bitwarden cannot
# autofill those, only the mobile app can. The .lan name comes from the Pi-hole
# search domain, so it needs no auth and survives the LAN IP changing.
#
# Off the home network the new tab will fail to load; that is the trade for not
# being prompted for a password every time a tab opens.
workstation_chromium_managed_policies:
  NewTabPageLocation: http://serverannah.lan:3000
omarchy_allow_ansible_package_installs: true

# External monitor stuck at 0x0 after unplug/replug, lid or dock changes.
# aquamarine 0.15.0 refuses the kernel "disable" commit for a connector that has
# just disconnected ("Cannot commit a disconnected output") but marks its CRTC
# free anyway; the kernel keeps that pipe scanning out, so the next monitor
# handed the same CRTC fails every modeset with EINVAL, even 640x480. Confirmed
# here with modetest (DP-3 disconnected yet still holding CRTC 269). Upstream:
# hyprwm/aquamarine#386 and #431; 0.15.1 is reported not to fix it on Intel.
# 0.14.0 has no such guard. They move together: 0.15 bumped the soname
# (libaquamarine.so 13 -> 14). hyprland-guiutils joined on 2026-10-19, when
# its 0.2.2-4 rebuild started requiring hyprtoolkit 0.6 (libhyprtoolkit.so=6,
# itself built on aquamarine 0.15) and so blocked every `omarchy update`.
# Still unfixed then: 0.15.1 and main keep the guard, #431 open. Lift the
# hold once a fixed release ships.
workstation_pacman_holds:
  - { name: aquamarine, version: 0.14.0-2 }
  - { name: hyprland, version: 0.56.2-1 }
  - { name: hyprtoolkit, version: 0.5.4-4 }
  - { name: hyprland-guiutils, version: 0.2.2-3 }
workstation_pacman_holds_reason: >-
  aquamarine 0.15 leaves an external monitor black (0x0) after it is unplugged
  and plugged back in. Held at the last working versions until upstream fixes it.
workstation_pacman_holds_upstream: https://github.com/hyprwm/aquamarine/issues/431

dotfiles_stow_packages:
