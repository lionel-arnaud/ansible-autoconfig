  - starship
  - claude
  - ssh
  - opencode
  - tuios
  - nvim
  - git
  - gh
  - lazygit
  - hypr
  - omarchy
  - wireplumber
  - systemd
  - scripts
  - espanso
  - voxtype

# Secret dotfiles deployed by copy-decrypt (not Stow). The vaulted source holds
# the real SSH host aliases; the public ssh package only ships the sanitized
# config that Includes this file. Needs a vault password at run time.
dotfiles_secret_files:
  - src: "{{ dotfiles_secret_source_dir }}/ssh/config.local"
    dest: .ssh/config.local
    mode: "0600"
    dir_mode: "0700"

# Systemd user services to enable after stow deploys them. rclone-gdrive-mount
# is deliberately NOT listed here: the workstation role templates that unit with
# this host's mount point and manages its lifecycle itself (see below), so
# listing it would enable it before the template had been written.
workstation_systemd_user_services:
  - audio-policy.service
  - freebox-mount.service
# The OpenCode maintenance unit is deployed by the systemd Stow package but is
# intentionally not enabled until this host has an unattended-capable provider.
# Both its configured Anthropic balance and OpenCode's free tier were exhausted
# when the unit was verified on 2026-11-11. Add the timer here after connecting
# a provider or renewing capacity:
#   - opencode-autonomous-maintenance.timer

# LocalSearch omits a separately configured FUSE root when it is nested below
# its broad $HOME root (confirmed in the LocalSearch debug log).  Mount Drive
# outside $HOME so it is crawled as its own root, while retaining the existing
# path as a symlink for applications and shell commands.
workstation_rclone_gdrive_enabled: true
workstation_rclone_gdrive_mount_point: "/mnt/lion-google-drive-perso"
workstation_rclone_gdrive_compatibility_link: "/home/lion/Google Drive Perso"
workstation_rclone_gdrive_bookmark_uri_rewrites:
  - from: "file:///home/lion/Google%20Drive%20Perso"
    to: "file:///mnt/lion-google-drive-perso"

# LocalSearch/Tracker retains this external rclone mount as a recursive root.
# Nautilus then searches its local, persistent index, including PDF and
# Markdown/plain-text content, instead of walking Drive at query time.
workstation_localsearch_enabled: true
workstation_localsearch_recursive_directories:
  - "/mnt/lion-google-drive-perso"
workstation_localsearch_remove_directories:
  - "/home/lion/Google Drive Perso"
# LocalSearch 3.12 extractors crash while misclassifying Go module cache files
# as audio. Exclude cache/download trees only; user files, projects, and Insync
# remain searchable in Nautilus.
workstation_localsearch_nomedia_directories:
  - "/home/lion/Downloads"
  - "/home/lion/go/pkg"
# Explicitly approved one-time rebuild; its durable marker prevents later
# ansible-pull runs from clearing the index again.
workstation_localsearch_initialize: true
workstation_localsearch_initialization_marker: >-
  /home/lion/.local/state/ansible-autoconfig/localsearch-rebuilt-with-go-cache-excluded
