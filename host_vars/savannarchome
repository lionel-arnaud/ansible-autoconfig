    label: Biomemory — Obsidian
    path: /home/lion/Documents/Obsidian/Biomemory
    peers: []
# Production Omarchy/Arch workstation. Runs the playbook locally (no SSH hop).
ansible_connection: local
ansible_user: lion
ansible_python_interpreter: /usr/bin/python3

