base_dotfiles_enabled: true
base_lazydocker_enabled: true
workstation_enabled: true
workstation_cli_enabled: true
workstation_dotfiles_enabled: true
workstation_espanso_enabled: true
workstation_keyd_enabled: true
# Paris, France. wlsunset derives daily local sunrise/sunset from these
# coordinates and controls only the display's color temperature.
workstation_astronomical_nightlight_enabled: true
workstation_astronomical_nightlight_latitude: 48.8566
workstation_astronomical_nightlight_longitude: 2.3522
workstation_astronomical_nightlight_temperature: 4000
autoconfig_fleet_controller_enabled: true
autoconfig_fleet_controller_targets:
