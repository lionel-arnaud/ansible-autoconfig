---
# kidsbook — Linux Mint 22.3 (Zena) XFCE on an old MacBook, x86_64.
# Reached over SSH as the admin account `daddy`; managed by the kids role.
ansible_host: 192.168.1.41
ansible_user: daddy
ansible_ssh_private_key_file: ~/.ssh/id_ed25519_homelab
ansible_python_interpreter: /usr/bin/python3

# This host only needs the kids baseline for now. The base role still applies
# (via the `all` play) so the machine gets the self-managing ansible-pull timer,
# but its workstation-flavoured extras stay off — no dotfiles, no Starship prompt
# rewrite, no lazydocker on a kids machine.
kids_enabled: true
base_dotfiles_enabled: false
base_starship_prompt_enabled: false
base_lazydocker_enabled: false
# Linux Mint 22.3 does not offer these optional workstation tools from its
# configured repositories, and Kidsbook does not use them.
base_cli_packages_exclude:
  - starship
  - lazygit
  - snapd

# Keep the strict Pi-hole client profile effective even when the router advertises
# an IPv6 resolver. The active Wi-Fi profile/device are discovered automatically.
kids_dns_enforcement_enabled: true
kids_dns_servers:
  - 192.168.1.100
kids_firefox_dns_over_https_disabled: true

# Report failed pulls and failed personal-file backups through the existing
# serverannah ntfy topic, so either machine can be diagnosed away from home. The
# topic itself is seeded once into /etc/ansible/secrets/notify-topic, never kept
# in this public repository.
notify_enabled: true
notify_show_subscribe_hint: false

# Personal folders are mirrored to serverannah's write-only inbox. Its Borg job
# keeps the retention history and encrypted off-site copy.
kids_backup_enabled: true
kids_backup_host_key: "192.168.1.100 ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMX9G6OI23dVKAGOGQzdnhYCtUfqfI1w28spHCW2IPcs"
