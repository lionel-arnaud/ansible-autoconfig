---
ansible_connection: local
ansible_python_interpreter: auto_silent

# serverannah pulls and applies its own config locally.
autoconfig_branch: main
autoconfig_playbook: local.yml

# Dotfiles enabled; dotfiles_stow_packages below is intentionally overridden to
# the server subset. Add packages here individually as they mature.
base_dotfiles_enabled: true
# Failure notifications. Nothing on this box could report a problem before:
# the nightly pull broke for a day in silence. The topic is generated on the
# host into /etc/ansible/secrets/notify-topic and printed once by the run so a
# phone can subscribe.
notify_enabled: true
server_fail2ban_enabled: true
fail2ban_caddy_basic_auth_enabled: true
server_backup_enabled: true
# Off-site copy of the Borg repo to Google Drive after each run. The repo is
# repokey-encrypted, so Google only ever sees opaque segments.
backup_offsite_enabled: true
backup_paths:
  - /opt/aumenuilya
  - /opt/nextcloud
  - /opt/pihole
  - /opt/homepage/config
  - /opt/reverse-proxy
  - /opt/dinnizer
  # opencode sessions live under the desktop user's XDG data home. Backing
  # them up keeps the conversation history and project state across provider
  # changes and reinstalls.
  - /home/lion/.local/share/opencode
  # Every generated service password lives here: the DB roots, the Nextcloud
  # admin and user passwords, dinnizer-secret-key-base, caddy-shared-password.
  # The DB dumps below were made *against* these passwords, so restoring dumps
  # onto a host that generated fresh ones gives you a Nextcloud whose database
  # and config.php disagree, and a Rails app whose encrypted columns are dead.
  # The Borg repo is encrypted, so this is safe to include — the one thing that
  # must stay outside is the Borg passphrase itself.
  - /etc/ansible/secrets
  # Jellyfin users, watch state and the seeded libraries.
  - /opt/jellyfin/config
  - /opt/game-timer/site
  - /opt/excalidraw
  - /opt/uptime-kuma
  # What a bare-metal rebuild needs first.
  - /etc/fstab
  - /etc/netplan
backup_database_dumps:
  - name: aumenuilya
    container: aumenuilya-db
    database: aumenuilkomyriam
    user: root
    password_file: /etc/ansible/secrets/aumenuilya-db-root-password
  - name: nextcloud
    container: nextcloud-db
    database: nextcloud
    user: root
    password_file: /etc/ansible/secrets/nextcloud-db-root-password
  - name: dinnizer
    engine: postgres
    container: dinnizer-db
    database: dinnizer_production
    user: dinnizer
    password_file: /etc/ansible/secrets/dinnizer-db-password
server_homepage_enabled: true
# External checks of the public sites, certs and DNS. Monitors are configured in
# its own UI; only the container and its route are managed here.
server_uptime_kuma_enabled: true
# Read-only Docker socket proxy, so Homepage never sees the raw socket.
server_docker_socket_proxy_enabled: true
# Bind the dashboard to the LAN address rather than 0.0.0.0. Caddy reaches it
# over the shared Docker network by name, so nothing needs the world-bound port;
# this keeps the direct-LAN fallback documented below without exposing an
# unauthenticated dashboard on every interface.
# Disks the dashboard reports usage for. These must match the disk list in
# files/homepage/opt/homepage/config/widgets.yaml: Homepage stats them from
# inside its container, so an unmounted path shows "API Error" instead of a bar.
# Read-only — a dashboard has no business writing to a media library or a backup
# repository. "/" needs no entry; the container already has its own root.
homepage_extra_volumes:
  - /mnt/SSD_1TO:/mnt/SSD_1TO:ro
  - /mnt/back-up:/mnt/back-up:ro
  - /mnt/verbatim:/mnt/verbatim:ro

homepage_published_ports:
  - "192.168.1.100:3000:3000"
server_bentopdf_enabled: true
server_game_timer_enabled: true
server_toki_suli_enabled: true
server_dinnizer_enabled: true
server_nextcloud_enabled: true
server_frigate_enabled: true
server_excalidraw_enabled: true
server_jellyfin_enabled: true
# Keep Pi-hole on the LAN address so systemd-resolved can continue to own the
# host loopback resolver while household clients use serverannah directly.
server_pihole_enabled: true
pihole_policy_import_enabled: true
# The restrictive Pi-hole profile applies only to Kidsbook's static DHCP lease.
# The role removes Pi-hole's implicit Default-group link before assigning rules.
pihole_kids_profile_enabled: true
pihole_kids_profile_clients:
  - 192.168.1.41

# Pi-hole local DNS records — short names every LAN client resolves via
# 192.168.1.100 (Pi-hole). Lets every device on the homelab refer to the
# homelab services by name without depending on /etc/hosts being in sync.
# serverannah itself (the Pi-hole host) is listed for completeness so reverse
# SSH tunnels, Caddy backends, and the opencode TUI all resolve identically
# on every host.
pihole_custom_dns_records:
  - name: serverannah
    ip: 192.168.1.100
  - name: ai.dinnizer.com
    ip: 192.168.1.100
pihole_mode: production
pihole_dns_listening_mode: ALL
pihole_published_ports:
  - "192.168.1.100:53:53/tcp"
  - "192.168.1.100:53:53/udp"
  - "192.168.1.100:8089:80"
server_lan_only_published_ports:
  - 3000
  - 8089
  - 8080
  - 8971
  - 8554
  - 8555
  - 32400
  - 8096
server_netplan_enabled: true
server_netplan_config: |
  # Managed by ansible-autoconfig.
  network:
    version: 2
    ethernets:
      enp1s0:
        wakeonlan: true
        match:
          macaddress: a4:bb:6d:52:98:10
        set-name: enp1s0
        addresses:
          - 192.168.1.100/24
        routes:
          - to: default
            via: 192.168.1.254
            metric: 100
        nameservers:
          addresses:
            - 127.0.0.1
            - 1.1.1.1
server_reverse_proxy_enabled: true
server_aumenuilya_enabled: true
server_opencode_enabled: true
server_rclone_gdrive_enabled: true
homepage_extra_allowed_hosts:
  # Caddy already adds X-Forwarded-Host on every request, so the public hostname
  # is the only strictly required entry. The LAN IP stays as a fallback so the
  # dashboard is reachable from the home network without going through DNS.
  - 192.168.1.100:3000
  - homepage.dinnizer.com
  # The container's own name on the shared Docker network. Uptime Kuma checks
  # the app directly at http://homepage:3000/ to see past Caddy's auth gate, and
  # Homepage rejects any Host header not listed here with a 400 — so without
  # this the monitor reports the dashboard down while it is perfectly healthy.
  - homepage:3000
  # The Pi-hole search domain form. This is what the workstations' Chromium new
  # tab points at: it needs no basic auth, so a new tab does not raise a
  # password prompt the way the public hostname would.
  - serverannah.lan:3000
server_reverse_proxy_auto_https: true
server_reverse_proxy_hsts_enabled: true
server_reverse_proxy_published_ports:
  - 80:80
  - 443:443
server_reverse_proxy_sites:
  - hostname: aumenuilya.fr
    redirect_to: https://www.aumenuilya.fr
  - hostname: www.aumenuilya.fr
    upstream: aumenuilya:80
  - hostname: tabletop-timer.com
    upstream: game-timer:80
  - hostname: toki.suli.dinnizer.com
    upstream: toki-suli:80
    # Public learning content, same as tabletop-timer.com/aumenuilya.fr — no
    # basic_auth (this isn't an admin-style dashboard).
  - hostname: www.tabletop-timer.com
    redirect_to: https://tabletop-timer.com
  - hostname: app.dinnizer.com
    upstream: dinnizer:3000
  - hostname: dinnizer.com
    redirect_to: https://www.dinnizer.com
  - hostname: homepage.dinnizer.com
    upstream: homepage:3000
    basic_auth: true
    basic_auth_password_file: "{{ server_reverse_proxy_secret_dir }}/caddy-shared-password"
  - hostname: status.dinnizer.com
    upstream: uptime-kuma:3001
    basic_auth: true
    basic_auth_password_file: "{{ server_reverse_proxy_secret_dir }}/caddy-shared-password"
    # The push endpoint is how the dead-man's switch reports in, and its token is
    # already the credential. curl from a systemd unit cannot present basic auth,
    # so exempting this one path is what makes the watchdog work at all. Reading
    # the dashboard still requires the password.
    basic_auth_except_paths:
      - /api/push/*
  - hostname: pdf.dinnizer.com
    upstream: bentopdf:8080
    basic_auth: true
    basic_auth_password_file: "{{ server_reverse_proxy_secret_dir }}/caddy-shared-password"
  - hostname: frigate.dinnizer.com
    upstream: https://frigate:8971
    upstream_tls_insecure_skip_verify: true
    basic_auth: true
    basic_auth_password_file: "{{ server_reverse_proxy_secret_dir }}/caddy-shared-password"
  - hostname: draw.dinnizer.com
    upstream: excalidraw:80
    basic_auth: true
    basic_auth_password_file: "{{ server_reverse_proxy_secret_dir }}/caddy-shared-password"
  - hostname: trader.dinnizer.com
    upstream: trader-dashboard:80
    # A static page, rendered on the Pi and pushed nightly. Behind the shared
    # password like every other admin page.
    basic_auth: true
    basic_auth_password_file: "{{ server_reverse_proxy_secret_dir }}/caddy-shared-password"
  - hostname: jelly.dinnizer.com
    upstream: "http://{{ jellyfin_lan_ip | default('192.168.1.100') }}:8096"
    # No basic_auth: Jellyfin clients authenticate via username + password or
    # an API key, neither of which is basic auth. A Caddy basic_auth gate here
    # would block the Jellyfin Web UI's login POST and every API call, with
    # no security benefit since Caddy's TLS already protects the channel and
    # Jellyfin's own user database enforces auth.
  - hostname: pihole.dinnizer.com
    upstream: pihole:80
    # Pi-hole answers 403 at "/" — it only serves the admin app below /admin.
    # Used by the Uptime Kuma seeder; Caddy itself proxies the whole host.
    monitor_path: /admin/login
    basic_auth: true
    basic_auth_password_file: "{{ server_reverse_proxy_secret_dir }}/caddy-shared-password"
  - hostname: cloud.dinnizer.com
    upstream: nextcloud:80
  - hostname: www.dinnizer.com
    upstream: dinnizer-website:80
  - hostname: ai.dinnizer.com
    upstream: "http://{{ opencode_lan_ip | default('192.168.1.100') }}:4096"
    # Same shared Caddy basic-auth as the other admin dashboards (pdf.dinnizer.com,
    # draw.dinnizer.com, etc.). Defense-in-depth: the opencode systemd unit also
    # exports OPENCODE_SERVER_PASSWORD from a user-only EnvironmentFile, so even
    # a LAN device that reaches 4096 directly still hits basic auth.
    basic_auth: true
    basic_auth_password_file: "{{ server_reverse_proxy_secret_dir }}/caddy-shared-password"
nextcloud_managed_users:
  - uid: lion
    display_name: lion
    password_file: /etc/ansible/secrets/nextcloud-admin-password
  - uid: mimi
    display_name: mimi
    password_file: /etc/ansible/secrets/nextcloud-mimi-password
nextcloud_external_mounts:
  - mount_point: /SSD_1TO
    path: /mnt/SSD_1TO
    users:
      - lion
      - mimi
nextcloud_trusted_proxies:
  - 172.18.0.0/16
nextcloud_external_mount_acl_excludes:
  - /mnt/SSD_1TO/nextcloud

# Redis distributed cache + file locking (clears the file-locking/memcache
# warnings and speeds Nextcloud up).
nextcloud_redis_enabled: true

# Outgoing mail via Gmail SMTP. The aliases hello@/lionel@dinnizer.com are
# Squarespace *forwarding* rules (inbound only, no SMTP), so we relay through
# Gmail, where those aliases already land. The app password lives on the host at
# nextcloud_smtp_password_file (mode 0600), never in this public repo.
nextcloud_smtp_enabled: true
nextcloud_smtp_host: smtp.gmail.com
nextcloud_smtp_port: 587
nextcloud_smtp_secure: tls
nextcloud_smtp_name: lionelarnaud84@gmail.com
nextcloud_smtp_from_address: lionel
nextcloud_smtp_from_domain: dinnizer.com

# occ-driven setup-warning fixes.
nextcloud_default_phone_region: FR
nextcloud_maintenance_window_start: 1          # 01:00 UTC (~03:00 local) low-usage
nextcloud_bruteforce_allowlist:
  - 192.168.1.0/24

# NOTE: Keep this list conservative for the production server. CLI tools like
# claude that are valid on servers can be added here individually.
dotfiles_stow_packages:
  - bash
  - starship
  - git
  - nvim
  # opencode ships its config (.config/opencode/opencode.json). The systemd
  # package no longer carries opencode-web.service or rclone-gdrive-mount.service:
  # the server role templates those two units with this host's LAN IP, port and
  # binary path, and a static Stow copy cannot express any of that. The copies
  # that used to live there held *unrendered* Jinja, so whenever Stow won the
  # race against the role systemd got a unit whose ExecStart was the literal
  # text "{{ opencode_binary }}".
  - opencode
  - systemd

# Storage stays simple: ship the target fstab as a normal file and copy it.
server_manage_fstab: true
server_fstab_src: "{{ playbook_dir }}/files/serverannah/etc/fstab"

# Public URLs and hardware details stay in host_vars because they are truly
# specific to this machine.
server_timeshift_enabled: true
timeshift_device_uuid: ed895069-ac77-4a4b-89c3-78bed9aeff22

# opencode web listens on the LAN address so the dashboard is reachable from
# Caddy (which sits on the host's docker bridge). The router only forwards
# 80/443 publicly, so a LAN-only bind keeps port 4096 unreachable from outside
# the home network even if the router is misconfigured. The systemd unit also
# exports OPENCODE_SERVER_PASSWORD from a user-only EnvironmentFile as
# defense-in-depth.
opencode_lan_ip: 192.168.1.100
server_opencode_lan_ip: 192.168.1.100

nextcloud_public_url: https://cloud.dinnizer.com
aumenuilya_backup_root: /mnt/SSD_1TO/BackUp/Mimi/AuMenuIlYA
aumenuilya_old_url: http://www.aumenuilya.fr
aumenuilya_public_url: https://www.aumenuilya.fr
frigate_camera_path: /dev/video0
frigate_devices:
  - /dev/video0:/dev/video0
  - /dev/dri/renderD128:/dev/dri/renderD128

# Jellyfin libraries seeded against /mnt/SSD_1TO via the container's /data
# bind mount. The seed runs after first-run setup completes and is idempotent
# on re-runs (the API returns the existing library for a duplicate name).
# Movies is intentionally `mixed` so the family-facing Movies tab on
# jelly.dinnizer.com surfaces documentaries (/data/Docus) and comedy
# (/data/Humour) alongside the proper movies — Plex did the same with
# the Movies type=1 + Docus type=show split, but in Jellyfin the
# matching UX is one combined view.
jellyfin_libraries:
  - name: Movies
    collection_type: mixed
    paths:
      - /data/Movies
      - /data/Docus
      - /data/Humour
    preferred_language: fr
  - name: TV Shows
    collection_type: tvshows
    paths:
      - /data/TV Shows
    preferred_language: fr
  - name: Music
    collection_type: music
    paths:
      - /data/Music
    preferred_language: fr

# Do not bind-mount personal photos into Jellyfin. The explicit mount list is
# also an access boundary: a newly created Jellyfin library cannot expose an
# unmounted directory from the SSD.
jellyfin_media_volumes:
  - "{{ jellyfin_media_root }}/Movies:/data/Movies:ro"
  - "{{ jellyfin_media_root }}/Docus:/data/Docus:ro"
  - "{{ jellyfin_media_root }}/Humour:/data/Humour:ro"
  - "{{ jellyfin_media_root }}/TV Shows:/data/TV Shows:ro"
  - "{{ jellyfin_media_root }}/Music:/data/Music:ro"
jellyfin_excluded_media_paths:
  - /data/Pictures

# Receive state pushed by other hosts (currently raspi's trading agent) so the
# existing Borg job carries it off-site. See roles/server/tasks/backup_inbox.yml.
backup_inbox_enabled: true
backup_inbox_clients:
  - name: raspi
    public_key_file: files/backup/raspi-trading-agent.pub
  # Root on Kidsbook owns this key. rrsync limits it to writes in this directory;
  # it cannot obtain a shell or read any backup data from serverannah.
  - name: kidsbook
    public_key: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMji6KV3bnKwqExKrlTHgExcB8SR9olpNHrw/AjjWZkw kidsbook-backup"

# Serve the trading agent's daily page from the backup inbox.
server_trader_dashboard_enabled: true
