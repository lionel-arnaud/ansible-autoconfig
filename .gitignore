# Raw backup material may still be parked here locally during migration work,
# but it is not part of the Ansible source of truth anymore.
backups/raspi/etc/pihole-bak/
backups/raspi/etc/gravity.db
backups/raspi/etc/dnsmasq.conf
backups/raspi/etc/listsCache/
backups/raspi/etc/versions

# Vault password files must never be committed to this public repo. Encrypted
# *content* (ansible-vault) is fine to commit; the password that unlocks it is not.
.ansible-vault-pass
secret.txt
*.vault-pass

# Throwaway virtualenv created by scripts/lint.sh
.lint-venv/

# Omarchy manages this nvim theme pointer locally (machine-specific symlink)
files/dotfiles/nvim/.config/nvim/lua/plugins/theme.lua

# Python bytecode: build output, never source.
__pycache__/
*.py[cod]
