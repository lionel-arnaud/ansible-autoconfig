# ~/.bashrc.local — legacy RSE-style helpers (LearnLinuxTV / Jay LaCroix lineage).
# Sourced at the very end of ~/.bashrc, AFTER omarchy/default/bash/rc and the
# managed ~/.bashrc. This file is part of the managed dotfiles repo and gets
# applied to every Omarchy host via GNU Stow (see dotfiles_managed_paths).
#
# Do not redefine anything already provided upstream:
#   - eza-based ls/la/ll/lt/lk, the zoxide-aware cd(), and the cat/pwd/df/ftext/
#     cpp/lazyg/cheat/whatsmyip wrappers all live in ~/.bashrc.
#   - completion bindings, history settings, and XDG dirs come from ~/.inputrc,
#     ~/.bashrc, and omarchy/default/bash/rc.
# Only ADD helpers here that are not already covered.

[[ $- != *i* ]] && return

#######################################################
# INTERACTIVE TWEAKS
#######################################################

# Visual bell instead of an audible one.
bind "set bell-style visible" 2>/dev/null

# Free Ctrl-S / Ctrl-Q for history navigation (Ctrl-R remains reverse search).
stty -ixon 2>/dev/null

# Make sure Ctrl-F stays "forward char" even if anything upstream grabbed it.
bind '"\C-f":forward-char' 2>/dev/null

# Editor defaults — Omarchy usually picks nvim, but make it explicit.
export EDITOR=nvim
export VISUAL=nvim
alias vim='nvim'
alias smicro='sudo micro'
alias snano='sudo nano'

# Cargo binaries on PATH (Omarchy already exports ~/.local/bin).
[[ -d $HOME/.cargo/bin ]] && export PATH="$HOME/.cargo/bin:$PATH"

# Nicer colors in less / manpages.
export LESS_TERMCAP_mb=$'\E[01;31m'
export LESS_TERMCAP_md=$'\E[01;31m'
export LESS_TERMCAP_me=$'\E[0m'
export LESS_TERMCAP_se=$'\E[0m'
export LESS_TERMCAP_so=$'\E[01;44;33m'
export LESS_TERMCAP_ue=$'\E[0m'
export LESS_TERMCAP_us=$'\E[01;32m'

#######################################################
# GENERAL ALIASES
#######################################################

# chmod helpers.
alias mx='chmod a+x'
alias 000='chmod -R 000'
alias 644='chmod -R 644'
alias 666='chmod -R 666'
alias 755='chmod -R 755'
alias 777='chmod -R 777'

# ls variants — extras on top of the eza-based ls/la/ll/lt/lk in ~/.bashrc.
alias lr='ls -lRh'                # recursive ls
alias lx='ls -lXBh'               # sort by extension
alias lc='ls -ltcrh'              # sort by change time
alias lu='ls -lturh'              # sort by access time
alias labc='ls -lap'              # alphabetical sort
alias lf="ls -l | egrep -v '^d'"  # files only
alias ldir="ls -l | egrep '^d'"   # directories only
alias lla='ls -Al'                # list and hidden files
alias las='ls -A'                 # hidden files
alias lls='ls -l'                 # plain list
alias lm='ls -alh |more'          # pipe through more
alias lw='ls -xAh'                # wide listing format

# Navigation.
alias home='cd ~'
alias cd..='cd ..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias bd='cd "$OLDPWD"'

# Inspection.
alias topcpu='/bin/ps -eo pcpu,pid,user,args | sort -k 1 -r | head -10'
alias p='ps aux | grep '
alias h='history | grep '
alias countfiles="for t in files links directories; do echo \`find . -type \${t:0:1} | wc -l\` \$t; done 2> /dev/null"
alias checkcommand='type -t'
alias openports='netstat -nape --inet'
alias rebootsafe='sudo shutdown -r now'
alias rebootforce='sudo shutdown -r -n now'
alias diskspace='du -S | sort -n -r |more'
alias folderssort='find . -maxdepth 1 -type d -print0 | xargs -0 du -sk | sort -rn'
alias mountedinfo='df -hT'

# Archives — extends mktar/mkgz/untar/ungz from ~/.bashrc.
alias mkbz2='tar -cvjf'
alias unbz2='tar -xvjf'

# Utilities.
alias logs="sudo find /var/log -type f -exec file {} \; | grep 'text' | cut -d' ' -f1 | sed -e's/:$//g' | grep -v '[0-9]$' | xargs tail -f"
alias sha1='openssl sha1'
alias da='date "+%Y-%m-%d %A %T %Z"'
alias ebrc="$EDITOR ~/.bashrc"
alias hlp='less ~/.bashrc_help'
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

# ansible-pull — identical on every managed host. `-d /opt/ansible-pull` is
# required because the role's Stow guard refuses to run when the checkout
# lands under /root/.ansible/pull/<host> (root-owned, lion can't read it);
# `local.yml` is the playbook to apply after the pull.
alias ap='sudo ansible-pull -U https://github.com/lionel-arnaud/ansible-autoconfig.git --vault-password-file ~/secret.txt -C main -d /opt/ansible-pull local.yml'

# opencode shortcuts.
# `c`  — left to Omarchy's default `opencode --auto` on Omarchy hosts. On
#        non-Omarchy hosts (serverannah, etc.) this file is sourced last so
#        it would shadow the default, which is why we deliberately do NOT
#        redefine `c` here.
# `ox` — drive the homelab opencode server from anywhere with LAN reach:
#        the phone on the home Wi-Fi, savannarchome on the LAN, or any host
#        pointed at the homelab DNS resolver. Uses serverannah.lan (Pi-hole
#        advertises the `lan` search domain) so the FQDN resolves uniformly
#        from every LAN client; the IP fallback covers the rare case of a
#        client with a non-Pi-hole DNS resolver. The password is read from
#        ~/.opencode-server-password (mode 0600, NOT in git — copy it once
#        from serverannah: scp serverannah:/etc/ansible/secrets/opencode-server-password
#        ~/.opencode-server-password). OPENCODE_SERVER_PASSWORD env var and
#        OPENCODE_SERVER_HOST override the file defaults. The `ox` spelling
#        matches Omarchy's letter-suffix convention (`cx` = claude, `cy` =
#        codex) and avoids clobbering Omarchy's `cx` ("clear screen + claude
#        --permission-mode auto").
ox_host="${OPENCODE_SERVER_HOST:-serverannah.lan}"
ox_pw_file="${OPENCODE_SERVER_PASSWORD_FILE:-$HOME/.opencode-server-password}"
alias ox='ox_pw=$( [[ -r "$ox_pw_file" ]] && cat "$ox_pw_file" ); OPENCODE_SERVER_PASSWORD="${OPENCODE_SERVER_PASSWORD:-$ox_pw}" OPENCODE_SERVER_USERNAME="${OPENCODE_SERVER_USERNAME:-lion}" exec opencode attach "http://${ox_host}:4096"'

#######################################################
# FUNCTIONS
#######################################################

# Universal archive extractor.
extract() {
    for archive in "$@"; do
        if [ -f "$archive" ]; then
            case $archive in
                *.tar.bz2) tar xvjf "$archive" ;;
                *.tar.gz)  tar xvzf "$archive" ;;
                *.bz2)     bunzip2 "$archive" ;;
                *.rar)     rar x "$archive" ;;
                *.gz)      gunzip "$archive" ;;
                *.tar)     tar xvf "$archive" ;;
                *.tbz2)    tar xvjf "$archive" ;;
                *.tgz)     tar xvzf "$archive" ;;
                *.zip)     unzip "$archive" ;;
                *.Z)       uncompress "$archive" ;;
                *.7z)      7z x "$archive" ;;
                *) echo "don't know how to extract '$archive'..." ;;
            esac
        else
            echo "'$archive' is not a valid file!"
        fi
    done
}

# Copy / move / mkdir and land in the destination directory.
cpg() { [ -d "$2" ] && cp "$1" "$2" && cd "$2" || cp "$1" "$2"; }
mvg() { [ -d "$2" ] && mv "$1" "$2" && cd "$2" || mv "$1" "$2"; }
mkdirg() { mkdir -p "$1" && cd "$1"; }

# Up N directories: `up 4` climbs four levels.
up() {
    local d="" limit=${1:-1}
    for ((i = 1; i <= limit; i++)); do d="$d/.."; done
    d=$(echo "$d" | sed 's/^\///')
    [ -z "$d" ] && d=..
    cd "$d"
}

# Print the last 2 fields of the current working directory.
pwdtail() { pwd | awk -F/ '{nlast = NF -1; print $nlast"/"$NF}'; }

# Trim leading and trailing whitespace from the arguments.
trim() {
    local var=$*
    var="${var#"${var%%[![:space:]]*}"}"
    var="${var%"${var##*[![:space:]]}"}"
    echo -n "$var"
}

# git add . && commit (no push). Use lazyg from ~/.bashrc for the full flow.
gcom() { git add . && git commit -m "$1"; }

# Upload a file to a hastebin-style paste service.
hb() {
    [ $# -eq 0 ] && { echo "No file path specified."; return; }
    [ ! -f "$1" ] && { echo "File path does not exist."; return; }
    local response hasteKey
    response=$(curl -s -X POST -d @"$1" "http://bin.christitus.com/documents")
    if [ $? -eq 0 ]; then
        hasteKey=$(echo "$response" | jq -r '.key')
        echo "http://bin.christitus.com/$hasteKey"
    else
        echo "Failed to upload the document."
    fi
}

# Distro detection helpers used by install_bashrc_support().
distribution() {
    local dtype="unknown"
    if [ -r /etc/os-release ]; then
        source /etc/os-release
        case $ID in
            fedora|rhel|centos) dtype="redhat" ;;
            sles|opensuse*)     dtype="suse" ;;
            ubuntu|debian)      dtype="debian" ;;
            gentoo)             dtype="gentoo" ;;
            arch|manjaro)       dtype="arch" ;;
            slackware)          dtype="slackware" ;;
        esac
        if [ "$dtype" = "unknown" ] && [ -n "$ID_LIKE" ]; then
            case $ID_LIKE in
                *fedora*|*rhel*|*centos*) dtype="redhat" ;;
                *sles*|*opensuse*)       dtype="suse" ;;
                *ubuntu*|*debian*)       dtype="debian" ;;
                *gentoo*)                dtype="gentoo" ;;
                *arch*)                  dtype="arch" ;;
                *slackware*)             dtype="slackware" ;;
            esac
        fi
    fi
    echo "$dtype"
}

ver() {
    local dtype
    dtype=$(distribution)
    case $dtype in
        redhat) [ -s /etc/redhat-release ] && cat /etc/redhat-release || cat /etc/issue; uname -a ;;
        suse)   cat /etc/SuSE-release ;;
        debian) lsb_release -a ;;
        gentoo) cat /etc/gentoo-release ;;
        arch)   cat /etc/os-release ;;
        slackware) cat /etc/slackware-version ;;
        *)      [ -s /etc/issue ] && cat /etc/issue || { echo "Error: Unknown distribution"; return 1; } ;;
    esac
}

# Cross-distro installer for the tooling assumed elsewhere in this file.
# Mostly historical — on Omarchy hosts these are pulled in by packages.sh.
install_bashrc_support() {
    local dtype
    dtype=$(distribution)
    case $dtype in
        redhat)
            sudo yum install multitail tree zoxide trash-cli fzf bash-completion fastfetch
            ;;
        suse)
            sudo zypper install multitail tree zoxide trash-cli fzf bash-completion fastfetch
            ;;
        debian)
            sudo apt-get install multitail tree zoxide trash-cli fzf bash-completion
            local url
            url=$(curl -s https://api.github.com/repos/fastfetch-cli/fastfetch/releases/latest \
                | grep "browser_download_url.*linux-amd64.deb" | cut -d '"' -f 4)
            curl -sL "$url" -o /tmp/fastfetch_latest_amd64.deb
            sudo apt-get install /tmp/fastfetch_latest_amd64.deb
            ;;
        arch)
            sudo pacman -S --needed multitail tree zoxide trash-cli fzf bash-completion fastfetch
            ;;
        slackware)
            echo "No install support for Slackware"
            ;;
        *)
            echo "Unknown distribution"
            ;;
    esac
}

# Apache / PHP / MySQL config shortcuts — useful on serverannah.
apachelog() {
    if [ -f /etc/httpd/conf/httpd.conf ]; then
        cd /var/log/httpd && ls -xAh && multitail --no-repeat -c -s 2 /var/log/httpd/*_log
    elif [ -d /var/log/apache2 ]; then
        cd /var/log/apache2 && ls -xAh && multitail --no-repeat -c -s 2 /var/log/apache2/*.log
    fi
}

apacheconfig() {
    local f
    if   [ -f /etc/httpd/conf/httpd.conf ]; then f=/etc/httpd/conf/httpd.conf
    elif [ -f /etc/apache2/apache2.conf ];   then f=/etc/apache2/apache2.conf
    fi
    if [ -n "$f" ]; then
        sudo "$EDITOR" "$f"
    else
        echo "Apache config not found; trying locate"
        sudo updatedb && locate httpd.conf apache2.conf
    fi
}

phpconfig() {
    local f
    for f in /etc/php.ini /etc/php/php.ini /etc/php5/php.ini /usr/bin/php5/bin/php.ini /etc/php5/apache2/php.ini; do
        [ -f "$f" ] && { sudo "$EDITOR" "$f"; return; }
    done
    echo "php.ini not found; trying locate"
    sudo updatedb && locate php.ini
}

mysqlconfig() {
    local f
    for f in /etc/my.cnf /etc/mysql/my.cnf /usr/local/etc/my.cnf /usr/bin/mysql/my.cnf ~/my.cnf ~/.my.cnf; do
        [ -f "$f" ] && { sudo "$EDITOR" "$f"; return; }
    done
    echo "my.cnf not found; trying locate"
    sudo updatedb && locate my.cnf
}