{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "diffs": {
    "wrap": "word"
  },
  "prompt": {
    "paste": "full",
    "image_preview": true
  },
  "tabs": {
    "mode": "on"
  },
  "session": {
    "permissions": "autoaccept",
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "image_preview": true
  },
  "animations": true,
  "keybinds": {
    "session.first": "ctrl+g,ctrl+home",
    "session.last": "ctrl+alt+g,ctrl+end",
    "input.line.home": "home",
    "input.line.end": "end",
    "model.cycle_recent": false,
    "model.cycle_favorite": "f2",
    "model.cycle_favorite_reverse": "shift+f2"
  },
  "plugins": [
    "*",
    "-opencode.notifications"
  ]
}
