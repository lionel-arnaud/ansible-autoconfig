{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "experimental": {
    "disable_paste_summary": true
  },
  "plugin": [
    "@mohak34/opencode-notifier@latest"
  ],
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "external_directory": "ask",
    "doom_loop": "ask"
  }
}
