# Managed by Ansible (roles/trading_agent). Do not edit on the host — the next
# pull overwrites it. Rendered from vaulted values; 0600 root.
ALPACA_API_KEY_ID={{ vault_alpaca_paper_key_id }}
ALPACA_API_SECRET_KEY={{ vault_alpaca_paper_secret_key }}
TELEGRAM_BOT_TOKEN={{ vault_telegram_bot_token }}
TELEGRAM_CHAT_ID={{ vault_telegram_chat_id }}
OPENCODE_URL={{ trading_agent_opencode_url | default('') }}
OPENCODE_USER={{ trading_agent_opencode_user | default('lion') }}
OPENCODE_PASSWORD={{ vault_opencode_password | default('') }}

# Both must change to reach live trading. See trading_agent/config.py.
TRADING_MODE={{ trading_agent_mode }}
LIVE_CONFIRMED={{ trading_agent_live_confirmed }}

MAX_POSITION_USD={{ trading_agent_max_position_usd }}
MAX_DEPLOYED_USD={{ trading_agent_max_deployed_usd }}
MAX_TRADES_PER_DAY={{ trading_agent_max_trades_per_day }}
DAILY_LOSS_LIMIT_USD={{ trading_agent_daily_loss_limit_usd }}
ACCOUNT_EQUITY_USD={{ trading_agent_account_equity_usd }}
APPROVAL_THRESHOLD_USD={{ trading_agent_approval_threshold_usd }}
APPROVAL_TTL_SECONDS={{ trading_agent_approval_ttl_seconds }}

STATE_DB={{ trading_agent_state_db }}
LOG_DIR={{ trading_agent_log_dir }}
