mqtt:
  enabled: false

cameras:
  {{ frigate_camera_name }}:
    ffmpeg:
      inputs:
        - path: {{ frigate_camera_path }}
          roles:
            - detect
      input_args:
        - -f
        - v4l2
        - -input_format
        - mjpeg
        # Pin the USB camera mode so ffmpeg does not decode a larger/default
        # MJPEG stream into Frigate's smaller detection frame and corrupt rows.
        - -video_size
        - "{{ frigate_detect_width }}x{{ frigate_detect_height }}"
        - -framerate
        - "{{ frigate_detect_fps }}"
    detect:
      width: {{ frigate_detect_width }}
      height: {{ frigate_detect_height }}
      fps: {{ frigate_detect_fps }}
    motion:
      threshold: {{ frigate_motion_threshold }}
      contour_area: {{ frigate_motion_contour_area }}
      improve_contrast: {{ frigate_motion_improve_contrast | ternary('true', 'false') }}
    zones:
      {{ frigate_zone_name }}:
        coordinates: {{ frigate_zone_coordinates }}
        loitering_time: 0

record:
  enabled: true
  alerts:
    retain:
      days: {{ frigate_alerts_retain_days }}
  detections:
    retain:
      days: {{ frigate_detections_retain_days }}
  # Frigate 0.17 replaced the single `record.retain.days` key with the separate
  # `continuous` and `motion` retentions, and migrates the old key on startup.
  # Both default to frigate_record_retain_days so this is exactly the shape
  # Frigate itself writes — otherwise Ansible and Frigate rewrite the file past
  # each other and restart the recorder on every run.
  continuous:
    days: {{ frigate_record_continuous_days }}
  motion:
    days: {{ frigate_record_motion_days }}

snapshots:
  enabled: true
  retain:
    default: {{ frigate_snapshots_retain_days }}
