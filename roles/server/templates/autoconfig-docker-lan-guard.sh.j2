#!/bin/sh
# Managed by Ansible (roles/server). Do not edit on the host: change the template
# and re-run the playbook instead.
#
# Purpose: keep selected Docker published ports reachable only from the LAN.
# Docker inserts its own ACCEPT rules into iptables that bypass the normal INPUT
# chain, so we filter inside the DOCKER-USER chain, which Docker evaluates first.
set -eu

# A dedicated chain keeps our rules isolated and idempotent: we flush and rebuild
# it every run instead of trying to surgically diff individual rules.
iptables -N AUTOCONFIG-LAN-ONLY 2>/dev/null || true
iptables -F AUTOCONFIG-LAN-ONLY

# Always allow replies to connections the host already accepted.
iptables -A AUTOCONFIG-LAN-ONLY -m conntrack --ctstate RELATED,ESTABLISHED -j RETURN
{% for cidr in server_lan_cidrs %}
iptables -A AUTOCONFIG-LAN-ONLY -s {{ cidr }} -j RETURN
{% endfor %}
# Anything that did not match a LAN source above is dropped.
iptables -A AUTOCONFIG-LAN-ONLY -j DROP

# Send each guarded published port through the chain above. -C tests first so we
# never stack duplicate jump rules across repeated runs.
#
# Both protocols: the guard used to emit TCP rules only, which left Frigate's
# WebRTC port published on 0.0.0.0/udp with no filter at all while its TCP twin
# was correctly guarded. Guarding UDP as well costs nothing for ports that only
# ever serve TCP — the rule simply never matches.
{% for port in server_lan_only_published_ports %}
{% for proto in server_lan_only_protocols %}
iptables -C DOCKER-USER -p {{ proto }} -m conntrack --ctorigdstport {{ port }} -j AUTOCONFIG-LAN-ONLY 2>/dev/null || iptables -I DOCKER-USER 1 -p {{ proto }} -m conntrack --ctorigdstport {{ port }} -j AUTOCONFIG-LAN-ONLY
{% endfor %}
{% endfor %}
# Drop jumps for any port or protocol no longer in the list. The loop above
# only ever adds, so removing a port from the configuration used to leave its
# rules in place indefinitely.
wanted="{% for port in server_lan_only_published_ports %}{% for proto in server_lan_only_protocols %} {{ port }}/{{ proto }}{% endfor %}{% endfor %} "
iptables -S DOCKER-USER | grep -- '-j AUTOCONFIG-LAN-ONLY' | while read -r rule; do
  port=$(printf '%s\n' "$rule" | sed -n 's/.*--ctorigdstport \([0-9]*\).*/\1/p')
  proto=$(printf '%s\n' "$rule" | sed -n 's/.* -p \([a-z]*\) .*/\1/p')
  case "$wanted" in
    *" $port/$proto "*) ;;
    *)
      # The rule text comes straight from iptables -S, so splitting it back
      # into arguments is exactly the intended round trip.
      # shellcheck disable=SC2046
      iptables $(printf '%s\n' "$rule" | sed 's/^-A /-D /')
      ;;
  esac
done

# Keep Docker's own RETURN terminator at the end of DOCKER-USER.
iptables -C DOCKER-USER -j RETURN 2>/dev/null || iptables -A DOCKER-USER -j RETURN
