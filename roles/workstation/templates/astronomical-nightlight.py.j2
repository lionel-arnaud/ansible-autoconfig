#!/usr/bin/env python3
"""Apply Hyprsunset's night-light mode using local astronomical sun times."""

from __future__ import annotations

import math
import os
from pathlib import Path
import subprocess
import sys
import time as time_module
from datetime import date, datetime, time, timedelta, timezone

LATITUDE = {{ workstation_astronomical_nightlight_latitude | float }}
LONGITUDE = {{ workstation_astronomical_nightlight_longitude | float }}
NIGHT_TEMPERATURE = {{ workstation_astronomical_nightlight_temperature | int }}
ZENITH = 90.833  # Official sunrise/sunset, including atmospheric refraction.


def solar_event(day: date, sunrise: bool) -> datetime:
    """Return the local astronomical sunrise or sunset for ``day``.

    This is the NOAA sunrise equation. It uses the local system time zone, so
    daylight-saving changes are handled by Python's zoneinfo support.
    """
    day_of_year = day.timetuple().tm_yday
    longitude_hour = LONGITUDE / 15
    approximate_time = day_of_year + ((6 if sunrise else 18) - longitude_hour) / 24
    mean_anomaly = (0.9856 * approximate_time) - 3.289
    true_longitude = (
        mean_anomaly
        + (1.916 * math.sin(math.radians(mean_anomaly)))
        + (0.020 * math.sin(math.radians(2 * mean_anomaly)))
        + 282.634
    ) % 360
    right_ascension = math.degrees(
        math.atan(0.91764 * math.tan(math.radians(true_longitude)))
    ) % 360
    right_ascension += (
        math.floor(true_longitude / 90) * 90
        - math.floor(right_ascension / 90) * 90
    )
    right_ascension /= 15
    sin_declination = 0.39782 * math.sin(math.radians(true_longitude))
    cos_declination = math.cos(math.asin(sin_declination))
    cosine_hour_angle = (
        math.cos(math.radians(ZENITH))
        - (sin_declination * math.sin(math.radians(LATITUDE)))
    ) / (cos_declination * math.cos(math.radians(LATITUDE)))
    if not -1 <= cosine_hour_angle <= 1:
        raise ValueError("Sunrise/sunset is undefined at this location today")
    hour_angle = math.degrees(math.acos(cosine_hour_angle))
    if sunrise:
        hour_angle = 360 - hour_angle
    local_mean_time = (hour_angle / 15) + right_ascension - (0.06571 * approximate_time) - 6.622
    universal_time = (local_mean_time - longitude_hour) % 24
    event_utc = datetime.combine(day, time(), timezone.utc) + timedelta(hours=universal_time)
    return event_utc.astimezone()


def main() -> int:
    now = datetime.now().astimezone()
    try:
        sunrise = solar_event(now.date(), sunrise=True)
        sunset = solar_event(now.date(), sunrise=False)
    except ValueError as error:
        print(error, file=sys.stderr)
        return 0

    state = "day"
    hyprsunset_args = ["--identity"]
    if sunrise <= now < sunset:
        pass
    else:
        state = "night"
        hyprsunset_args = ["--temperature", str(NIGHT_TEMPERATURE)]

    state_file = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / (
        "autoconfig-astronomical-nightlight-state"
    )
    current_state = state_file.read_text().strip() if state_file.exists() else ""
    hyprsunset_running = (
        subprocess.run(
            ["pgrep", "-x", "hyprsunset"], capture_output=True, check=False
        ).returncode
        == 0
    )
    if hyprsunset_running and current_state == state:
        return 0

    # Omarchy launches Hyprsunset through UWSM rather than its upstream
    # systemd unit. Version 0.4.0's IPC socket can disappear while the process
    # remains alive, so select the desired static mode at process launch
    # instead of relying on `hyprctl hyprsunset`. Only restart at a solar state
    # change (or after login) to avoid a visible five-minute flicker.
    subprocess.run(["pkill", "-x", "hyprsunset"], check=False)
    subprocess.Popen(
        ["uwsm-app", "--", "hyprsunset", *hyprsunset_args],
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    for _ in range(10):
        time_module.sleep(0.2)
        if (
            subprocess.run(
                ["pgrep", "-x", "hyprsunset"], capture_output=True, check=False
            ).returncode
            == 0
        ):
            state_file.write_text(f"{state}\n")
            break
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
