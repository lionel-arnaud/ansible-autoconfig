[Unit]
Description=Apply astronomical Wayland night light
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/wlsunset -l {{ workstation_astronomical_nightlight_latitude }} -L {{ workstation_astronomical_nightlight_longitude }} -T 6500 -t {{ workstation_astronomical_nightlight_temperature }}
Restart=on-failure

[Install]
WantedBy=graphical-session.target
